table 'public fact_despachos'
	lineageTag: 60c40a2c-e76d-47ea-8227-20e7c4203f4f

	measure 'Registros' = COUNTROWS('public fact_despachos')
		formatString: #,0
		displayFolder: KPI

	measure 'Total pasajeros' = SUM('public fact_despachos'[pasajeros])
		formatString: #,0
		displayFolder: KPI

	measure 'Buses despachados' = SUM('public fact_despachos'[despachos])
		formatString: #,0
		displayFolder: KPI

	measure 'Pasajeros-km' = SUM('public fact_despachos'[pax_km])
		formatString: #,0
		displayFolder: KPI

	measure 'Ocupación %' = DIVIDE(SUM('public fact_despachos'[pasajeros]), SUM('public fact_despachos'[capacidad_total])) * 100
		formatString: 0.0
		displayFolder: KPI

	measure 'Meta ocupación %' = 80
		formatString: 0
		displayFolder: KPI

	measure 'Máximo ocupación %' = 100
		formatString: 0
		displayFolder: KPI

	measure 'Brecha ocupación pp' = [Meta ocupación %] - [Ocupación %]
		formatString: 0.0
		displayFolder: KPI

	measure 'Pasajeros por bus' = DIVIDE([Total pasajeros], [Buses despachados])
		formatString: 0.0
		displayFolder: KPI

	measure '% Vacíos' = DIVIDE(CALCULATE(COUNTROWS('public fact_despachos'), 'public fact_despachos'[viaje_vacio] = TRUE()), COUNTROWS('public fact_despachos')) * 100
		formatString: 0.0
		displayFolder: KPI

	measure '% Crítica' = DIVIDE(CALCULATE(COUNTROWS('public fact_despachos'), 'public fact_despachos'[factor_ocupacion_pct] < 35), COUNTROWS('public fact_despachos')) * 100
		formatString: 0.0
		displayFolder: KPI

	measure 'Emisiones t' = DIVIDE(SUM('public fact_despachos'[emisiones_kg_co2e]), 1000)
		formatString: #,0
		displayFolder: KPI

	measure 'Intensidad real' = DIVIDE(SUM('public fact_despachos'[emisiones_kg_co2e]), SUM('public fact_despachos'[pax_km]))
		formatString: 0.0000
		displayFolder: KPI

	measure 'Intensidad ideal' = DIVIDE(SUM('public fact_despachos'[emisiones_kg_co2e]), SUM('public fact_despachos'[pax_km_ideal]))
		formatString: 0.0000
		displayFolder: KPI

	measure 'Exceso %' = DIVIDE([Intensidad real] - [Intensidad ideal], [Intensidad ideal]) * 100
		formatString: 0.0
		displayFolder: KPI

	measure 'Evitables t' = DIVIDE(SUM('public fact_despachos'[emisiones_kg_co2e]) - SUM('public fact_despachos'[pax_km]) * [Intensidad ideal], 1000)
		formatString: #,0
		displayFolder: KPI

	measure 'Galones evitables' = [Evitables t] * 1000 / 10.15
		formatString: #,0
		displayFolder: KPI

	measure 'Participación evitables %' = DIVIDE([Evitables t], CALCULATE([Evitables t], ALL('public dim_origen'), ALL('public dim_destino'))) * 100
		formatString: 0.00
		displayFolder: KPI

