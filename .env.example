# Copia este archivo como .env y ajusta los valores (.env no se sube a git)

# PostgreSQL (contenedor db_movilidad)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=movilidad
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# JupyterLab (contenedor jupyter_analytics)
JUPYTER_TOKEN=cambia_este_token
